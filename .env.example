# Copy this file to .env and fill in real values for your local machine.
# .env is already excluded in .gitignore — never commit the real file.

# --- Supabase (Project Settings > API in the Supabase dashboard) ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# --- IMPORTANT SECURITY NOTE ---
# The Supabase "service_role" key must NEVER appear in this file, in the app
# bundle, or anywhere in this repository. It bypasses Row Level Security.
# It is only ever used from a secure server-side context (e.g. a Supabase
# Edge Function), and even then it should be stored as an Edge Function
# secret, not committed to source control.
