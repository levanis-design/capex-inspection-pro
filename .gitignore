# Dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native build output (only relevant if you ever run a local prebuild;
# EAS Build handles native builds in the cloud so these normally don't exist)
android/
ios/

# Environment variables — NEVER commit real secrets
.env
.env.local
.env.*.local

# Signing / credentials — NEVER commit these
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision
credentials.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json

# Test coverage
coverage/

# TypeScript build info
*.tsbuildinfo
